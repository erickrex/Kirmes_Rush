{
  "name": "rythm-foundation",
  "version": "0.1.0",
  "description": "Rythm Foundation - Phaser JS 4.0.0 Migration",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tool:convert-legacy-songs": "node ./tools/legacy/song-converter.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.typecheck.json",
    "typecheck:strict": "tsc --noEmit --project jsconfig.json",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\"",
    "test": "vitest --run --config vitest.unit.config.js",
    "test:unit": "vitest --run --config vitest.unit.config.js",
    "test:integration": "vitest --run --config vitest.integration.config.js",
    "test:all": "npm run test:unit && npm run test:integration"
  },
  "keywords": [
    "rythm-foundation",
    "rhythm-game",
    "phaser",
    "game"
  ],
  "author": "",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fast-check": "^4.5.3",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "jsdom": "^27.3.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "phaser": "4.0.0"
  }
}
